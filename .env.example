# Solami API key with the DataApi permission (https://solami.dev)
SOLAMI_API_KEY=

# Smallest trade (USD) that counts as a whale trade
MIN_VOLUME_USD=10000

# Wallets you always want to follow, comma-separated (any trade size)
WATCHLIST=

# Dashboard port
PORT=3000

# Optional: Telegram alerts. Create a bot with @BotFather, then put your chat/channel id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only alert on trades at least this big (defaults to MIN_VOLUME_USD)
TELEGRAM_MIN_USD=50000

# Set to 1 to run with fake data (no API key needed) for UI work
MOCK=0
